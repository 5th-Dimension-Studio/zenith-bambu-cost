+cmake_minimum_required(VERSION 3.16)
+project(ZenithCostTests LANGUAGES CXX)
+enable_testing()
+get_filename_component(STUDIO_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
+add_executable(zenith_cost_test cost_test.cpp)
+target_include_directories(zenith_cost_test PRIVATE "${STUDIO_ROOT}/src")
+target_compile_features(zenith_cost_test PRIVATE cxx_std_17)
+# Assertions must stay active in Release builds.
+if(MSVC)
+  target_compile_options(zenith_cost_test PRIVATE /UNDEBUG)
+else()
+  target_compile_options(zenith_cost_test PRIVATE -UNDEBUG)
+endif()
+add_test(NAME zenith_cost COMMAND zenith_cost_test)
+# Compile the panel against Bambu's actual bundled ImGui interface. Linking the
+# entire application and its dependencies is performed by the Windows build.
+add_library(zenith_panel_compile OBJECT panel_test.cpp)
+target_include_directories(zenith_panel_compile PRIVATE "${STUDIO_ROOT}/src")
+target_compile_features(zenith_panel_compile PRIVATE cxx_std_17)
diff --git a/zenith/tests/cost_test.cpp b/zenith/tests/cost_test.cpp
new file mode 100644
index 0000000..54921f2
--- /dev/null
+++ b/zenith/tests/cost_test.cpp
@@ -0,0 +1,47 @@
+#include "slic3r/GUI/GCodeRenderer/ZenithCost.hpp"
+#include <cassert>
+#include <iostream>
+#include <limits>
+#include <map>
+using namespace ZenithCost;
+struct MemoryConfig {
+    std::map<std::string, std::string> values;
+    std::string get(const std::string& section, const std::string& key) const {
+        auto it = values.find(section + "/" + key);
+        return it == values.end() ? "" : it->second;
+    }
+    void set(const std::string& section, const std::string& key, const std::string& value) {
+        values[section + "/" + key] = value;
+    }
+};
+void near(double actual, double expected) { assert(std::abs(actual - expected) < 1e-8); }
+int main() {
+    Settings s;
+    auto r = calculate(150, 18000, 0, s);
+    near(r.material, 135); near(r.total, 135); near(r.profit, 67.5); near(r.price, 202.5);
+    s.electricity_on = s.machine_on = s.wear_on = s.packaging_on = s.shipping_on = true;
+    r = calculate(150, 18000, 0, s);
+    near(r.electricity, 5.25); near(r.machine, 35); near(r.wear, 26.2875);
+    near(r.total, 251.5375); near(r.price, 377.30625);
+    s.profile_prices = true;
+    // 120 g @ 800/kg + 80 g @ 1000/kg + 35 g @ 900/kg.
+    r = calculate(235, 3600, 207.5, s);
+    near(r.material, 207.5);
+    s.markup_percent = 0; near(calculate(235, 3600, 207.5, s).profit, 0);
+    s.markup_percent = 150; r = calculate(235, 3600, 207.5, s); near(r.price, r.total * 2.5);
+    s = Settings{}; s.electricity_on = true;
+    r = calculate(0, 1800, 0, s); near(r.total, 0.525); near(r.machine, 0);
+    for (double bad : {-1.0, std::numeric_limits<double>::quiet_NaN(), std::numeric_limits<double>::infinity()}) {
+        bool threw = false; try { calculate(bad, 3600, 0, s); } catch (const std::invalid_argument&) { threw = true; } assert(threw);
+    }
+    bool threw = false; try { calculate(100, 0, 0, s); } catch (const std::invalid_argument&) { threw = true; } assert(threw);
+    MemoryConfig config;
+    s.markup_percent = 62.5; s.profile_prices = true; s.shipping_on = true;
+    save(config, s); auto restored = load(config);
+    near(restored.markup_percent, 62.5); assert(restored.profile_prices && restored.shipping_on);
+    config.set("zenith_print_cost", "filament_kg", "-900");
+    near(load(config).filament_kg, 900);
+    for (const char* bad : {"nan", "inf", "1e100", "abc", "9junk", "9,5"}) near(parse(bad, 7), 7);
+    near(parse("12.50", 7), 12.5); near(parse(number(62.5), 0), 62.5);
+    std::cout << "PASS: calculator, toggles, markup, profile totals, invalid data and settings round-trip\n";
+}
