+#include "slic3r/GUI/ZenithTransform.hpp"
+#include <cassert>
+#include <iostream>
+using namespace ZenithTransform;
+static double number(Input& input, const char* text) {
+    input.text.clear();
+    for (const char* c = text; *c; ++c) assert(input.append(*c));
+    double result = 0;
+    assert(input.value(result));
+    return result;
+}
+int main() {
+    Input input;
+    assert(!input.active());
+    input.mode = Mode::Move;
+    input.constrain(0, false);
+    assert(number(input, "1") == 1);
+    assert((input.mask() == std::array<double,3>{{1,0,0}}));
+    assert(number(input, "-10.25") == -10.25);
+    input.mode = Mode::Rotate;
+    input.constrain(2, false);
+    assert(input.constraint_name() == "Z");
+    assert(number(input, "90") == 90);
+    input.mode = Mode::Scale;
+    input.constrain(2, true);
+    const double factor = number(input, ".5");
+    assert(factor == 0.5);
+    assert((input.scaling(factor) == std::array<double,3>{{0.5,0.5,1}}));
+    assert(input.constraint_name() == "XY");
+    // Repeated global constraint clears; switching preserves numeric entry.
+    input.constrain(2, true);
+    assert(input.axis == -1 && input.text == ".5");
+    assert((input.scaling(0.5) == std::array<double,3>{{0.5,0.5,0.5}}));
+    input.constrain(0, false);
+    assert((input.scaling(2) == std::array<double,3>{{2,1,1}}));
+    input.constrain(1, true);
+    assert((input.scaling(2) == std::array<double,3>{{2,1,2}}));
+    double v;
+    for (const char* bad : {"-", ".", "-.", "0", "-1", "nan", "1e99", "abc", "1..2", "1001"}) {
+        input.text=bad; assert(!input.value(v));
+    }
+    input.text="0.001"; assert(input.value(v));
+    input.text="1000"; assert(input.value(v));
+    input.text=".5"; assert(!input.append('.')); assert(input.text==".5");
+    input.append('-'); assert(input.text=="-.5"); input.append('-'); assert(input.text==".5");
+    input.mode=Mode::Move; input.text="0"; assert(input.value(v));
+    input.text="1000001"; assert(!input.value(v));
+    input.text="-1000000"; assert(input.value(v));
+    input.mode=Mode::Rotate; input.axis=-1; input.constrain(2,true);
+    assert(input.axis==2 && !input.plane);
+    assert(snap(7.6,5)==10); assert(snap(-7.6,5)==-10);
+    assert(snap(0.49,1)==0);
+    std::cout<<"PASS: G X 1, R Z 90, S Shift+Z .5, constraints, decimals, signs, bounds and snapping\n";
+}
